{
  "name": "astroforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight rocket workshop and PyLoN v1 UDP flight simulator",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:physics": "node scripts/build-physics.js",
    "prestart": "npm run build:physics && npm run docs:build",
    "predev": "npm run build:physics && npm run docs:build",
    "pretest": "npm run build:physics",
    "prebenchmark": "npm run build:physics",
    "prebenchmark:physics": "npm run build:physics",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "benchmark": "node tests/benchmark.js",
    "benchmark:physics": "node scripts/benchmark-physics.js",
    "demo": "node examples/demo.js",
    "demo:python": "python3 examples/launch.py",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20"
  }
}
